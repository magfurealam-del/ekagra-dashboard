{
  "name": "ekagra-dashboard",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/mis-ingestion",
      "schedule": "*/5 0-1,18-23 * * *"
    },
    {
      "path": "/api/cron/populate-outgoing-calls",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/sync-invoice-corrections",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/refresh-dashboard-snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-messenger",
      "schedule": "0 20 * * *"
    }
  ]
}
